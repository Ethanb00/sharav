---
import Layout from '../layouts/Layout.astro';
import { productsV3 } from '@wix/stores';
import { items } from '@wix/data';
import { imgSrc } from '../lib/wix-media';
import { MENU_BY_NAME } from '../data/menu';
import fs from 'node:fs';
import path from 'node:path';

import { getEntry, render } from 'astro:content';
const site = (await getEntry('docs', 'site'))!.data;
const hero = (await getEntry('docs', 'hero'))!.data;
const food = (await getEntry('docs', 'food'))!.data;
const find = (await getEntry('docs', 'find'))!.data;
const order = (await getEntry('docs', 'order'))!.data;
const catering = (await getEntry('docs', 'catering'))!.data;
const faq = (await getEntry('docs', 'faq'))!.data;
const newsletter = (await getEntry('docs', 'newsletter'))!.data;
const whereToBuy = (await getEntry('docs', 'where-to-buy'))!.data;
const storyEntry = (await getEntry('docs', 'our-story'))!;
const story = storyEntry.data;
const { Content: StoryContent } = await render(storyEntry);

const chefEntry = (await getEntry('docs', 'chef'))!;
const chef = chefEntry.data;
const { Content: ChefContent } = await render(chefEntry);

// Optional — the layout collapses gracefully to a full-width column until the real file
// is dropped into public/images/photo-family.jpg.
const hasFamilyPhoto = fs.existsSync(path.join(process.cwd(), 'public/images/photo-family.jpg'));

let products: any[] = [];
try {
	const res = await productsV3.queryProducts().limit(20).find();
	products = res.items ?? [];
} catch (err) {
	console.error('Failed to load products', err);
}

// Presentation content per product — matched by name (cosmetic only; price/name are always
// read live from Wix Stores above; copy and the dish photo come from ../data/menu/*.ts).
const MENU_META = MENU_BY_NAME;

products = [...products]
	.filter((p) => MENU_META[p.name])
	.sort((a, b) => MENU_META[a.name].order - MENU_META[b.name].order);

const mainDishes = products.filter((p) => !MENU_META[p.name].dark);
const darkDishes = products.filter((p) => MENU_META[p.name].dark);

let schedule: any[] = [];
try {
	const res = await items.query('market-schedule').ascending('order').find();
	schedule = res.items ?? [];
} catch (err) {
	console.error('Failed to load market schedule', err);
}

// Fixed hero photo — a standalone Wix Media asset, independent of the Hummus product's
// catalog image (that one keeps coming live from Wix Stores in the dish grid below).
const HERO_IMAGE_ID = 'wix:image://v1/9647c1_3bfc5b48f34c4941a07d3c5410f598bc~mv2.jpg/photo-hummus.jpg#originWidth=2475&originHeight=3094';
const heroImage = imgSrc(HERO_IMAGE_ID, 900, 900);

function formatMarketDate(d: string): string {
	return new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
}

function priceLine(p: any): string {
	const amount = Number(p.actualPriceRange?.minValue?.amount ?? 0);
	const suffix: Record<string, string> = {
		zhug: '6 oz',
		hummus: '8 oz',
		baba: '8 oz',
		muhammara: '8 oz',
		carrot: '8 oz',
		pita: 'two',
		tea: '',
	};
	const sku = MENU_META[p.name]?.sku ?? '';
	const s = suffix[sku];
	return s ? `$${amount.toFixed(0)} · ${s}` : `$${amount.toFixed(0)}`;
}
---

<Layout>
	<header class="site-header">
		<div class="wrap header-inner">
			<a href="#top" aria-label="Sharav home">
				<img src="/images/brand/logo-h-terracotta.svg" alt="Sharav - Mizrahi Cuisine" class="wordmark-img" />
			</a>
			<nav class="site-nav">
				<a href="#food">The Food</a>
				<a href="#find">Find Us</a>
				<a href="#story">Our Story</a>
				<a href="#catering">Catering</a>
				<a href="#order" class="nav-cta">Preorder · <span id="cart-count">0</span></a>
			</nav>
		</div>
	</header>

	<main>
		<!-- Hero -->
		<section id="top" class="hero">
			<div class="hero-copy">
				<h1>{hero.heading_prefix} <span id="place-rotator">{hero.places[0]}</span></h1>
				<p class="hero-sub">{hero.sub}</p>
				<div class="hero-actions">
					<a href="#order" class="btn btn-cream">{hero.cta_primary}</a>
					<a href="#find" class="btn btn-outline-cream">{hero.cta_secondary}</a>
				</div>
				<div class="hero-tag">{site.location_tag}</div>
			</div>
			<div class="hero-img">
				{heroImage && <img src={heroImage} alt="Hummus with olive oil, sumac and pine nuts" />}
			</div>
		</section>

		<!-- Food -->
		<section id="food" class="wrap food-section">
			<div class="food-head">
				<div class="food-head-copy">
					<div class="eyebrow">{food.eyebrow}</div>
					<h2 class="h2">{food.heading}</h2>
					<p class="body-olive">{food.intro}</p>
				</div>
				<a href="#order" class="preorder-link">{food.preorder_link}</a>
			</div>

			<div class="food-grid">
				{mainDishes.map((p) => {
					const meta = MENU_META[p.name];
					const img = imgSrc(meta.image, 500, 460);
					return (
						<article class="dish-card" data-sku={meta.sku} data-name={p.name} data-price={p.actualPriceRange?.minValue?.amount ?? '0'}>
							{img ? (
								<img src={img} alt={p.name} class="dish-img" />
							) : (
								<div class="dish-img dish-img-placeholder">
									<div class="placeholder-label">Photo coming soon</div>
								</div>
							)}
							<div class="dish-body">
								<h3>{p.name}</h3>
								{meta.eyebrow && <div class={`dish-eyebrow ${meta.sku === 'zhug' ? 'mauve' : ''}`}>{meta.eyebrow}</div>}
								<p class="dish-desc">{meta.description}</p>
								<div class="dish-price">{priceLine(p)}</div>
								<button type="button" class="btn btn-rust add-to-order">Add to order</button>
							</div>
						</article>
					);
				})}

				<article class="dish-stack">
					{darkDishes.map((p) => {
						const meta = MENU_META[p.name];
						return (
							<div class={`dish-dark dish-dark-${meta.dark}`} data-sku={meta.sku} data-name={p.name} data-price={p.actualPriceRange?.minValue?.amount ?? '0'}>
								<div class="dish-dark-head">
									<h3>{p.name}</h3>
									<div class="dish-dark-price">{priceLine(p)}</div>
								</div>
								<p class="dish-dark-desc">{meta.description}</p>
								<button type="button" class="btn btn-cream-small add-to-order">Add to order</button>
							</div>
						);
					})}
				</article>
			</div>
		</section>

		<!-- Find us -->
		<section id="find" class="find-section">
			<div class="wrap find-inner">
				<div class="find-copy">
					<div class="eyebrow gold">{find.eyebrow}</div>
					<h2 class="h2 cream">{find.heading}</h2>
					<p class="body-cream">{find.intro}</p>
					<div class="find-contact">
						<div class="eyebrow gold small">{find.contact_label}</div>
						<div><a href={site.phone_href} class="contact-link">{site.phone}</a></div>
						<div><a href={`mailto:${site.email}`} class="contact-link">{site.email}</a></div>
					</div>
				</div>
				<div class="schedule">
					<div class="schedule-head">
						<div class="eyebrow gold small">{find.schedule_label}</div>
						<div class="confirm-pill">{find.schedule_confirm_pill}</div>
					</div>

					{schedule.length > 0 ? (
						schedule.map((s) => {
							const isOlney = /olney/i.test(s.market ?? '') && find.market_dates?.length > 0;
							return (
								<div class="schedule-row">
									<div>
										<div class="schedule-name">{s.market}</div>
										{isOlney ? (
											<div class="date-list">
												{find.schedule_time && <div class="schedule-sub-line">{find.schedule_time}</div>}
												<div class="date-grid">
													{find.market_dates.map((d: string) => (
														<div class="date-chip">{formatMarketDate(d)}</div>
													))}
												</div>
											</div>
										) : (
											<div class="schedule-sub">{s.day}</div>
										)}
									</div>
									{!isOlney && <div class="schedule-time">{s.time}</div>}
								</div>
							);
						})
					) : find.market_dates?.length > 0 ? (
						<div class="schedule-row">
							<div>
								<div class="schedule-name">Olney Farmers Market</div>
								<div class="date-list">
									{find.schedule_time && <div class="schedule-sub-line">{find.schedule_time}</div>}
									<div class="date-grid">
										{find.market_dates.map((d: string) => (
											<div class="date-chip">{formatMarketDate(d)}</div>
										))}
									</div>
								</div>
							</div>
						</div>
					) : (
						<div class="schedule-row"><div class="schedule-name">{find.schedule_empty}</div></div>
					)}
				</div>
			</div>
		</section>

		<!-- Order -->
		<section id="order" class="wrap order-section">
			<div class="order-copy">
				<div class="eyebrow">{order.eyebrow}</div>
				<h2 class="h2">{order.heading}</h2>
				<p class="body-olive">{order.intro}</p>
				<div class="how-it-works">
					<div class="eyebrow olive small">{order.how_it_works_label}</div>
					<p>{order.how_it_works_text}</p>
				</div>
				<div class="good-to-know">
					<div class="eyebrow small">{order.good_to_know_label}</div>
					<p class="body-olive">{order.good_to_know_note}</p>
					<p class="body-olive" set:html={order.good_to_know_contact_html} />
				</div>
			</div>

			<form id="preorder-form" class="order-form" novalidate>
				<div class="cart-block">
					<div class="eyebrow small">Your order</div>
					<ul class="cart-lines" id="cart-lines">
						<li class="cart-empty" id="cart-empty">Nothing added yet - pick from the food above.</li>
					</ul>
					<div class="cart-subtotal">
						<span class="eyebrow olive small">Subtotal</span>
						<span class="cart-total" id="cart-total">$0</span>
					</div>
				</div>
				<div class="form-row-2">
					<input type="text" name="full_name" placeholder="Name" required />
					<input type="tel" name="phone" placeholder="Phone" required />
				</div>
				<input type="email" name="email" placeholder="Email" required />
				<textarea name="notes" rows="3" placeholder="Anything else - allergies, which pickup, a note"></textarea>
				<p class="form-status" id="preorder-status" role="status"></p>
				<button type="submit" class="btn btn-rust btn-block">Continue to payment</button>
			</form>
		</section>

		<!-- Story -->
		<section id="story" class="wrap story-wrap">
			<div class="story-editorial">
				<div class="eyebrow">{story.eyebrow}</div>
				<h2 class="h2">{story.heading}</h2>
				<article class="editorial-body">
					<figure class="float-figure float-left">
						<img src="/images/photo-ethan.jpg" alt="Ethan in the kitchen" />
						<figcaption>{story.caption}</figcaption>
					</figure>
					<StoryContent />
				</article>
				<div class="why-box">
					<div class="eyebrow cream small">{story.why_label}</div>
					<p>{story.why_text}</p>
				</div>
			</div>

			<div class="story-editorial">
				<div class="eyebrow">{chef.eyebrow}</div>
				<h2 class="h2">{chef.heading}</h2>
				<article class="editorial-body">
					{hasFamilyPhoto && (
						<figure class="float-figure float-right">
							<img src="/images/photo-family.jpg" alt={chef.family_caption} />
							<figcaption>{chef.family_caption}</figcaption>
						</figure>
					)}
					<ChefContent />
				</article>



				<p class="chef-epilogue">{chef.epilogue}</p>
				<div class="byline">
					<div class="byline-rule"></div>
					<div>{story.byline}</div>
				</div>

				<div class="chef-quote-break">
					<blockquote>
						<p>&ldquo;{chef.pull_quote}&rdquo;</p>
						<cite>&mdash; {chef.quote_attribution}</cite>
					</blockquote>
				</div>

			</div>
		</section>

		<!-- Catering -->
		<section id="catering" class="catering-section">
			<div class="wrap catering-inner">
				<div class="catering-copy">
					<div class="eyebrow cream">{catering.eyebrow}</div>
					<h2 class="h2 cream">{catering.heading}</h2>
					<p class="body-cream">{catering.intro}</p>
					<div class="pill-row">
						{catering.pills.map((pill: string) => <div class="pill">{pill}</div>)}
					</div>
				</div>
				<form id="catering-form" class="catering-form" novalidate>
					<div class="eyebrow small">{catering.quote_label}</div>
					<div class="form-row-2">
						<input type="text" name="full_name" placeholder="Name" required />
						<input type="email" name="email" placeholder="Email" required />
					</div>
					<div class="form-row-2">
						<input type="date" name="event_date" required />
						<input type="number" name="guest_count" placeholder="Guests" min="1" required />
					</div>
					<textarea name="occasion" rows="3" placeholder="What's the occasion?" required></textarea>
					<p class="form-status" id="catering-status" role="status"></p>
					<button type="submit" class="btn btn-rust btn-block">Send inquiry</button>
				</form>
			</div>
		</section>

		<!-- FAQ + Newsletter -->
		<section class="wrap faq-section">
			<div class="faq-col">
				<div class="eyebrow">{faq.eyebrow}</div>
				<h2 class="h2-sm">{faq.heading}</h2>
				<div class="faq-list">
					{faq.items.map((item: { q: string; a: string }, i: number) => (
						<div class={`faq-row ${i === faq.items.length - 1 ? 'faq-row-last' : ''}`}>
							<div class="faq-q">{item.q}</div>
							<div class="faq-a">{item.a}</div>
						</div>
					))}
				</div>
			</div>
			<div class="side-col">
				<form class="newsletter-form" id="newsletter-form" novalidate>
					<div class="eyebrow gold small">{newsletter.main_label}</div>
					<p class="body-cream-90">{newsletter.main_text}</p>
					<input type="text" name="name" placeholder="Name (optional)" />
					<div class="newsletter-row">
						<input type="email" name="email" required placeholder="your@email.com" />
						<button type="submit" class="btn btn-gold">{newsletter.main_cta}</button>
					</div>
					<p class="form-status" id="newsletter-status" role="status"></p>
				</form>
				<div class="where-to-buy">
					<div class="eyebrow">{whereToBuy.eyebrow}</div>
					<p class="body-olive" set:html={whereToBuy.text_html} />
					<img src="/images/brand/ill-4-terracotta.svg" alt="" class="illustration" aria-hidden="true" />
				</div>
			</div>
		</section>
	</main>

	<footer class="site-footer">
		<div class="wrap footer-inner">
			<div class="footer-brand">
				<img src="/images/brand/logo-h-cream.svg" alt="Sharav - Mizrahi Cuisine" class="footer-wordmark" />
				<div class="footer-contact">
					{site.location_tag}<br />
					<a href={`mailto:${site.email}`}>{site.email}</a> · <a href={site.phone_href}>{site.phone}</a>
				</div>
			</div>
			<form class="footer-newsletter-form" id="footer-newsletter-form" novalidate>
				<div class="eyebrow gold small">{newsletter.footer_label}</div>
				<div class="footer-newsletter-copy">{newsletter.footer_text}</div>
				<input type="text" name="name" placeholder="Name (optional)" />
				<input type="email" name="email" required placeholder="your@email.com" />
				<button type="submit" class="btn btn-gold-block">{newsletter.footer_cta}</button>
				<p class="form-status" id="footer-newsletter-status" role="status"></p>
			</form>
			<div class="footer-links">
				<div class="footer-link-col">
					<div class="eyebrow gold small">Visit</div>
					<a href="#food">The food</a>
					<a href="#find">Markets</a>
					<a href="#order">Order</a>
				</div>
				<div class="footer-link-col">
					<div class="eyebrow gold small">More</div>
					<a href="#story">Our story</a>
					<a href="#catering">Catering</a>
					<a href={site.instagram_url} target="_blank" rel="noopener">{site.instagram_handle}</a>
				</div>
			</div>
		</div>
		<div class="footer-bottom-bar">
			<div class="wrap footer-bottom-text">© {new Date().getFullYear()} Sharav · Made by hand in Maryland 🌻</div>
		</div>
	</footer>
</Layout>

<style>
	.h2 {
		font-size: 40px;
	}
	.h2-sm {
		font-size: 34px;
		margin-top: 12px;
	}
	.cream {
		color: var(--cream);
	}
	.body-olive {
		color: var(--olive);
		font-size: 16px;
		line-height: 1.6;
	}
	.body-cream {
		color: var(--cream);
		font-size: 16px;
		line-height: 1.6;
	}
	.body-cream-90 {
		color: rgba(237, 226, 211, 0.9);
		font-size: 15.5px;
		line-height: 1.6;
	}
	.eyebrow.gold {
		color: var(--gold);
	}
	.eyebrow.olive {
		color: var(--olive);
	}
	.eyebrow.cream {
		color: var(--cream);
	}
	.eyebrow.small {
		font-size: 12px;
	}

	.btn {
		display: inline-block;
		border: 0;
		font-family: var(--font-body);
		font-weight: 600;
		cursor: pointer;
		text-align: center;
		transition: background 0.15s ease, color 0.15s ease;
	}
	.btn-rust {
		padding: 13px 18px;
		background: var(--rust);
		color: var(--cream);
		font-size: 14px;
	}
	.btn-rust:hover {
		background: var(--espresso);
		color: var(--cream);
	}
	.btn-block {
		width: 100%;
		padding: 17px;
		font-size: 15px;
	}
	.btn-cream {
		padding: 16px 30px;
		background: var(--cream);
		color: var(--rust);
		font-size: 15px;
	}
	.btn-cream:hover {
		background: var(--gold);
		color: var(--espresso);
	}
	.btn-outline-cream {
		padding: 16px 30px;
		border: 1px solid rgba(237, 226, 211, 0.55);
		color: var(--cream);
		font-size: 15px;
		font-weight: 500;
	}
	.btn-outline-cream:hover {
		border-color: var(--cream);
		background: rgba(237, 226, 211, 0.1);
	}
	.btn-cream-small {
		padding: 11px 16px;
		background: var(--cream);
		color: var(--espresso);
		font-size: 13.5px;
	}
	.btn-cream-small:hover {
		background: var(--gold);
	}
	.btn-gold {
		flex: 0 0 auto;
		width: auto;
		padding: 14px 22px;
		background: var(--gold);
		color: var(--espresso);
		font-size: 14.5px;
		white-space: nowrap;
	}
	.btn-gold:hover {
		background: var(--cream);
	}
	.btn-gold-block {
		padding: 13px;
		background: var(--gold);
		color: var(--espresso);
		font-size: 14px;
	}
	.btn-gold-block:hover {
		background: var(--cream);
	}

	/* Hero */
	.hero {
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-items: stretch;
		min-height: 620px;
	}
	.hero-copy {
		background: var(--rust);
		padding: 92px 72px;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 26px;
	}
	.hero-copy h1 {
		font-size: clamp(34px, 3.9vw, 54px);
		color: var(--cream);
		line-height: 1.08;
	}
	#place-rotator {
		display: block;
		width: fit-content;
		border-bottom: 3px solid var(--gold);
		padding-bottom: 0.04em;
		animation: sharavPlaceIn 560ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
	}
	.hero-sub {
		max-width: 30em;
		font-size: 17px;
		line-height: 1.6;
		color: var(--cream);
	}
	.hero-actions {
		display: flex;
		align-items: center;
		gap: 14px;
		flex-wrap: wrap;
		margin-top: 6px;
	}
	.hero-tag {
		margin-top: 6px;
		font-size: 13px;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: rgba(237, 226, 211, 0.75);
	}
	.hero-img {
		background: var(--espresso);
	}
	.hero-img img {
		width: 100%;
		height: 100%;
		min-height: 620px;
		object-fit: cover;
	}
	@media (max-width: 1000px) {
		.hero {
			grid-template-columns: 1fr;
			gap: 0;
		}
		.hero-copy {
			padding: 68px 24px;
		}
		.hero-img img {
			min-height: 400px;
		}
	}
	@media (max-width: 660px) {
		.hero-copy {
			padding: 56px 20px;
		}
		.hero-img img {
			min-height: 300px;
		}
	}

	/* Food */
	.food-section {
		padding: 96px 32px 40px;
	}
	.food-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 40px;
		flex-wrap: wrap;
	}
	.food-head-copy {
		display: flex;
		flex-direction: column;
		gap: 14px;
		max-width: 34em;
	}
	.preorder-link {
		font-size: 14px;
