---
import Layout from '../layouts/Layout.astro';
import { productsV3 } from '@wix/stores';
import { items } from '@wix/data';
import { imgSrc } from '../lib/wix-media';
import { MENU_BY_NAME } from '../data/menu';

let products: any[] = [];
try {
	const res = await productsV3.queryProducts().limit(20).find();
	products = res.items ?? [];
} catch (err) {
	console.error('Failed to load products', err);
}

// Presentation content per product — matched by name (cosmetic only; price/name are always
// read live from Wix Stores above; copy and the dish photo come from ../data/menu/*.ts).
const MENU_META = MENU_BY_NAME;

products = [...products]
	.filter((p) => MENU_META[p.name])
	.sort((a, b) => MENU_META[a.name].order - MENU_META[b.name].order);

const mainDishes = products.filter((p) => !MENU_META[p.name].dark);
const darkDishes = products.filter((p) => MENU_META[p.name].dark);

let schedule: any[] = [];
try {
	const res = await items.query('market-schedule').ascending('order').find();
	schedule = res.items ?? [];
} catch (err) {
	console.error('Failed to load market schedule', err);
}

// Fixed hero photo — a standalone Wix Media asset, independent of the Hummus product's
// catalog image (that one keeps coming live from Wix Stores in the dish grid below).
const HERO_IMAGE_ID = 'wix:image://v1/9647c1_3bfc5b48f34c4941a07d3c5410f598bc~mv2.jpg/photo-hummus.jpg#originWidth=2475&originHeight=3094';
const heroImage = imgSrc(HERO_IMAGE_ID, 900, 900);

function priceLine(p: any): string {
	const amount = Number(p.actualPriceRange?.minValue?.amount ?? 0);
	const suffix: Record<string, string> = {
		zhug: '6 oz',
		hummus: '8 oz',
		baba: '8 oz',
		muhammara: '8 oz',
		carrot: '8 oz',
		pita: 'two',
		tea: '',
	};
	const sku = MENU_META[p.name]?.sku ?? '';
	const s = suffix[sku];
	return s ? `$${amount.toFixed(0)} · ${s}` : `$${amount.toFixed(0)}`;
}
---

<Layout>
	<header class="site-header">
		<div class="wrap header-inner">
			<a href="#top" aria-label="Sharav home">
				<img src="/images/brand/logo-h-terracotta.svg" alt="Sharav - Mizrahi Cuisine" class="wordmark-img" />
			</a>
			<nav class="site-nav">
				<a href="#food">The Food</a>
				<a href="#find">Find Us</a>
				<a href="#story">Our Story</a>
				<a href="#catering">Catering</a>
				<a href="#order" class="nav-cta">Preorder · <span id="cart-count">0</span></a>
			</nav>
		</div>
	</header>

	<main>
		<!-- Hero -->
		<section id="top" class="hero">
			<div class="hero-copy">
				<h1>The heritage and warmth of Mizrahi cooking, fresh in <span id="place-rotator">Olney</span></h1>
				<p class="hero-sub">Small-batch Mizrahi dishes, made by hand each week.</p>
				<div class="hero-actions">
					<a href="#order" class="btn btn-cream">Preorder for pickup</a>
					<a href="#find" class="btn btn-outline-cream">Find us at the market</a>
				</div>
				<div class="hero-tag">Greater Washington, DC Area</div>
			</div>
			<div class="hero-img">
				{heroImage && <img src={heroImage} alt="Hummus with olive oil, sumac and pine nuts" />}
			</div>
		</section>

		<!-- Food -->
		<section id="food" class="wrap food-section">
			<div class="food-head">
				<div class="food-head-copy">
					<div class="eyebrow">The Food</div>
					<h2 class="h2">Five recipes, made well, made often</h2>
					<p class="body-olive">
						Everything is made fresh each week in small batches. Come taste before you buy - there's a different spread out for sampling every market.
					</p>
				</div>
				<a href="#order" class="preorder-link">Pre-order for pickup</a>
			</div>

			<div class="food-grid">
				{mainDishes.map((p) => {
					const meta = MENU_META[p.name];
					const img = imgSrc(meta.image, 500, 460);
					return (
						<article class="dish-card" data-sku={meta.sku} data-name={p.name} data-price={p.actualPriceRange?.minValue?.amount ?? '0'}>
							{img ? (
								<img src={img} alt={p.name} class="dish-img" />
							) : (
								<div class="dish-img dish-img-placeholder">
									<div class="placeholder-label">Photo coming soon</div>
								</div>
							)}
							<div class="dish-body">
								<h3>{p.name}</h3>
								{meta.eyebrow && <div class={`dish-eyebrow ${meta.sku === 'zhug' ? 'mauve' : ''}`}>{meta.eyebrow}</div>}
								<p class="dish-desc">{meta.description}</p>
								<div class="dish-price">{priceLine(p)}</div>
								<button type="button" class="btn btn-rust add-to-order">Add to order</button>
							</div>
						</article>
					);
				})}

				<article class="dish-stack">
					{darkDishes.map((p) => {
						const meta = MENU_META[p.name];
						return (
							<div class={`dish-dark dish-dark-${meta.dark}`} data-sku={meta.sku} data-name={p.name} data-price={p.actualPriceRange?.minValue?.amount ?? '0'}>
								<div class="dish-dark-head">
									<h3>{p.name}</h3>
									<div class="dish-dark-price">{priceLine(p)}</div>
								</div>
								<p class="dish-dark-desc">{meta.description}</p>
								<button type="button" class="btn btn-cream-small add-to-order">Add to order</button>
							</div>
						);
					})}
				</article>
			</div>
		</section>

		<!-- Find us -->
		<section id="find" class="find-section">
			<div class="wrap find-inner">
				<div class="find-copy">
					<div class="eyebrow gold">Find Us</div>
					<h2 class="h2 cream">Come taste it.</h2>
					<p class="body-cream">
						You'll find us at the Olney Farmers Market. Everything is made the day before, so come early for the full lineup, and there's a spread out for sampling every week.
					</p>
					<div class="find-contact">
						<div class="eyebrow gold small">Questions before you come</div>
						<div><a href="tel:+12403088109" class="contact-link">(240) 308-8109</a></div>
						<div><a href="mailto:hello@eatsharav.com" class="contact-link">hello@eatsharav.com</a></div>
					</div>
				</div>
				<div class="schedule">
					<div class="schedule-head">
						<div class="eyebrow gold small">This season's schedule</div>
						<div class="confirm-pill">Confirm dates</div>
					</div>
					{schedule.length > 0 ? (
						schedule.map((s) => (
							<div class="schedule-row">
								<div>
									<div class="schedule-name">{s.market}</div>
									<div class="schedule-sub">{s.day}</div>
								</div>
								<div class="schedule-time">{s.time}</div>
							</div>
						))
					) : (
						<div class="schedule-row"><div class="schedule-name">Schedule coming soon</div></div>
					)}
				</div>
			</div>
		</section>

		<!-- Order -->
		<section id="order" class="wrap order-section">
			<div class="order-copy">
				<div class="eyebrow">Order</div>
				<h2 class="h2">Pre-order for pickup</h2>
				<p class="body-olive">
					Send your order and pick it up at the Olney Farmers Market on Sunday, 9AM to 1PM, or the following Monday at a location in North Bethesda.
				</p>
				<div class="how-it-works">
					<div class="eyebrow olive small">How it works</div>
					<p>Add your dishes and continue to secure payment through Square. Your order is confirmed once payment clears - just show up at pickup.</p>
				</div>
				<div class="good-to-know">
					<div class="eyebrow small">Good to know</div>
					<p class="body-olive">
						Every container is marked with a best-by date - keep it refrigerated and use your own judgment from there. Made in a kitchen that handles sesame, walnuts and pistachios. Zhug is the only hot one.
					</p>
					<p class="body-olive">
						Questions or a special request about getting your pre-order, delivery included? <a href="mailto:hello@eatsharav.com">Reach out</a> and we'll work it out.
					</p>
				</div>
			</div>

			<form id="preorder-form" class="order-form" novalidate>
				<div class="cart-block">
					<div class="eyebrow small">Your order</div>
					<ul class="cart-lines" id="cart-lines">
						<li class="cart-empty" id="cart-empty">Nothing added yet - pick from the food above.</li>
					</ul>
					<div class="cart-subtotal">
						<span class="eyebrow olive small">Subtotal</span>
						<span class="cart-total" id="cart-total">$0</span>
					</div>
				</div>
				<div class="form-row-2">
					<input type="text" name="full_name" placeholder="Name" required />
					<input type="tel" name="phone" placeholder="Phone" required />
				</div>
				<input type="email" name="email" placeholder="Email" required />
				<textarea name="notes" rows="3" placeholder="Anything else - allergies, which pickup, a note"></textarea>
				<p class="form-status" id="preorder-status" role="status"></p>
				<button type="submit" class="btn btn-rust btn-block">Continue to payment</button>
			</form>
		</section>

		<!-- Story -->
		<section id="story" class="wrap story-section">
			<div class="story-media">
				<img src="/images/photo-ethan.jpg" alt="Ethan in the kitchen" class="story-img" />
				<div class="story-caption">Ethan, in the kitchen on a batch day.</div>
			</div>
			<div class="story-copy">
				<div class="eyebrow">Our Story</div>
				<h2 class="h2">A wind that belongs to no one</h2>
				<p>
					Sharav is the Hebrew word for the dry desert wind - the heat that sweeps across the region and leaves everything sharper once it has passed. The same wind is known everywhere it blows, by a different name in every language: <em>khamsin</em> in Arabic, <em>sirocco</em> across the Mediterranean, <em>ghibli</em> in Tunisia, <em>harmattan</em> in the Maghreb.
				</p>
				<p class="body-olive">It belongs to no single people. It touches everyone. That is the whole idea behind this food.</p>
				<p class="body-olive">
					Mizrahi means "Eastern" - the Jews of Iraq and Iran, Yemen and Syria, Morocco and Tunisia, Egypt and Kurdistan. Some of the oldest continuous communities on earth, and the reason this food tastes the way it does: it was never made in isolation. Ingredients, techniques and recipes moved in every direction, shared across faiths and borders, passed hand to hand.
				</p>
				<div class="why-box">
					<div class="eyebrow cream small">Why we cook it</div>
					<p>
						In one generation, close to a million Jews left, fled or were forced out of lands their families had lived in for two thousand years. What they carried was recipes held in memory and spice blends learned from grandmothers. Cooking it is how it stays.
					</p>
				</div>
				<div class="byline">
					<div class="byline-rule"></div>
					<div>Ethan - founder, and the one at the stove</div>
				</div>
			</div>
		</section>

		<!-- Catering -->
		<section id="catering" class="catering-section">
			<div class="wrap catering-inner">
				<div class="catering-copy">
					<div class="eyebrow cream">Catering</div>
					<h2 class="h2 cream">Feeding a room full of people</h2>
					<p class="body-cream">
						Mezze spreads for holidays, b'nai mitzvah, office lunches and weddings. Platters by the tray, pita by the dozen, tea by the urn. Tell us the date and the headcount and we'll send a quote.
					</p>
					<div class="pill-row">
						<div class="pill">Holiday tables</div>
						<div class="pill">B'nai mitzvah</div>
						<div class="pill">Office lunch</div>
						<div class="pill">Weddings</div>
					</div>
				</div>
				<form id="catering-form" class="catering-form" novalidate>
					<div class="eyebrow small">Request a quote</div>
					<div class="form-row-2">
						<input type="text" name="full_name" placeholder="Name" required />
						<input type="email" name="email" placeholder="Email" required />
					</div>
					<div class="form-row-2">
						<input type="date" name="event_date" required />
						<input type="number" name="guest_count" placeholder="Guests" min="1" required />
					</div>
					<textarea name="occasion" rows="3" placeholder="What's the occasion?" required></textarea>
					<p class="form-status" id="catering-status" role="status"></p>
					<button type="submit" class="btn btn-rust btn-block">Send inquiry</button>
				</form>
			</div>
		</section>

		<!-- FAQ + Newsletter -->
		<section class="wrap faq-section">
			<div class="faq-col">
				<div class="eyebrow">Questions</div>
				<h2 class="h2-sm">The things people ask</h2>
				<div class="faq-list">
					<div class="faq-row">
						<div class="faq-q">How hot is the zhug, really?</div>
						<div class="faq-a">Hot. It's a condiment, not a dip - a spoonful stirred into hummus or spread thin on bread. Everything else in the lineup is mild.</div>
					</div>
					<div class="faq-row">
						<div class="faq-q">How long does it keep?</div>
						<div class="faq-a">Every container is marked with a best-by date. Nothing is preserved or pasteurized, so keep it cold and use your best judgment.</div>
					</div>
					<div class="faq-row">
						<div class="faq-q">Allergens?</div>
						<div class="faq-a">Sesame in everything with tahini. Walnuts in the muhammara, pistachios in the carrot dip. All made in one kitchen, so we can't promise no cross-contact.</div>
					</div>
					<div class="faq-row faq-row-last">
						<div class="faq-q">Is it vegan? Kosher?</div>
						<div class="faq-a">The dips are all plant-based. We're not certified kosher - ask us and we'll tell you exactly how we cook.</div>
					</div>
				</div>
			</div>
			<div class="side-col">
				<form class="newsletter-form" id="newsletter-form" novalidate>
					<div class="eyebrow gold small">Where we're headed next</div>
					<p class="body-cream-90">One email a week: which market we'll be at, what's in the batch, and what's out for sampling.</p>
					<input type="text" name="name" placeholder="Name (optional)" />
					<div class="newsletter-row">
						<input type="email" name="email" required placeholder="your@email.com" />
						<button type="submit" class="btn btn-gold">Join our list</button>
					</div>
					<p class="form-status" id="newsletter-status" role="status"></p>
				</form>
				<div class="where-to-buy">
					<div class="eyebrow">Where to buy</div>
					<p class="body-olive">
						Right now it's markets, pre-order pickup and local delivery - no shelves yet. If you run a shop or a café and want to carry it, <a href="mailto:hello@eatsharav.com">write to us</a>.
					</p>
					<img src="/images/brand/ill-4-terracotta.svg" alt="" class="illustration" aria-hidden="true" />
				</div>
			</div>
		</section>
	</main>

	<footer class="site-footer">
		<div class="wrap footer-inner">
			<div class="footer-brand">
				<img src="/images/brand/logo-h-cream.svg" alt="Sharav - Mizrahi Cuisine" class="footer-wordmark" />
				<div class="footer-contact">
					Greater Washington, DC Area<br />
					<a href="mailto:hello@eatsharav.com">hello@eatsharav.com</a> · <a href="tel:+12403088109">(240) 308-8109</a>
				</div>
			</div>
			<form class="footer-newsletter-form" id="footer-newsletter-form" novalidate>
				<div class="eyebrow gold small">Our list</div>
				<div class="footer-newsletter-copy">One email a week - where we'll be and what's in the batch.</div>
				<input type="text" name="name" placeholder="Name (optional)" />
				<input type="email" name="email" required placeholder="your@email.com" />
				<button type="submit" class="btn btn-gold-block">Join our list</button>
				<p class="form-status" id="footer-newsletter-status" role="status"></p>
			</form>
			<div class="footer-links">
				<div class="footer-link-col">
					<div class="eyebrow gold small">Visit</div>
					<a href="#food">The food</a>
					<a href="#find">Markets</a>
					<a href="#order">Order</a>
				</div>
				<div class="footer-link-col">
					<div class="eyebrow gold small">More</div>
					<a href="#story">Our story</a>
					<a href="#catering">Catering</a>
					<a href="https://instagram.com/eatsharav" target="_blank" rel="noopener">@eatsharav</a>
				</div>
			</div>
		</div>
		<div class="footer-bottom-bar">
			<div class="wrap footer-bottom-text">© {new Date().getFullYear()} Sharav · Made by hand in Maryland 🌻</div>
		</div>
	</footer>
</Layout>

<style>
	.h2 {
		font-size: 40px;
	}
	.h2-sm {
		font-size: 34px;
		margin-top: 12px;
	}
	.cream {
		color: var(--cream);
	}
	.body-olive {
		color: var(--olive);
		font-size: 16px;
		line-height: 1.6;
	}
	.body-cream {
		color: var(--cream);
		font-size: 16px;
		line-height: 1.6;
	}
	.body-cream-90 {
		color: rgba(237, 226, 211, 0.9);
		font-size: 15.5px;
		line-height: 1.6;
	}
	.eyebrow.gold {
		color: var(--gold);
	}
	.eyebrow.olive {
		color: var(--olive);
	}
	.eyebrow.cream {
		color: var(--cream);
	}
	.eyebrow.small {
		font-size: 12px;
	}

	.btn {
		display: inline-block;
		border: 0;
		font-family: var(--font-body);
		font-weight: 600;
		cursor: pointer;
		text-align: center;
		transition: background 0.15s ease, color 0.15s ease;
	}
	.btn-rust {
		padding: 13px 18px;
		background: var(--rust);
		color: var(--cream);
		font-size: 14px;
	}
	.btn-rust:hover {
		background: var(--espresso);
		color: var(--cream);
	}
	.btn-block {
		width: 100%;
		padding: 17px;
		font-size: 15px;
	}
	.btn-cream {
		padding: 16px 30px;
		background: var(--cream);
		color: var(--rust);
		font-size: 15px;
	}
	.btn-cream:hover {
		background: var(--gold);
		color: var(--espresso);
	}
	.btn-outline-cream {
		padding: 16px 30px;
		border: 1px solid rgba(237, 226, 211, 0.55);
		color: var(--cream);
		font-size: 15px;
		font-weight: 500;
	}
	.btn-outline-cream:hover {
		border-color: var(--cream);
		background: rgba(237, 226, 211, 0.1);
	}
	.btn-cream-small {
		padding: 11px 16px;
		background: var(--cream);
		color: var(--espresso);
		font-size: 13.5px;
	}
	.btn-cream-small:hover {
		background: var(--gold);
	}
	.btn-gold {
		flex: 0 0 auto;
		width: auto;
		padding: 14px 22px;
		background: var(--gold);
		color: var(--espresso);
		font-size: 14.5px;
		white-space: nowrap;
	}
	.btn-gold:hover {
		background: var(--cream);
	}
	.btn-gold-block {
		padding: 13px;
		background: var(--gold);
		color: var(--espresso);
		font-size: 14px;
	}
	.btn-gold-block:hover {
		background: var(--cream);
	}

	/* Hero */
	.hero {
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-items: stretch;
		min-height: 620px;
	}
	.hero-copy {
		background: var(--rust);
		padding: 92px 72px;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 26px;
	}
	.hero-copy h1 {
		font-size: clamp(34px, 3.9vw, 54px);
		color: var(--cream);
		line-height: 1.08;
	}
	#place-rotator {
		display: block;
		width: fit-content;
		border-bottom: 3px solid var(--gold);
		padding-bottom: 0.04em;
		animation: sharavPlaceIn 560ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
	}
	.hero-sub {
		max-width: 30em;
		font-size: 17px;
		line-height: 1.6;
		color: var(--cream);
	}
	.hero-actions {
		display: flex;
		align-items: center;
		gap: 14px;
		flex-wrap: wrap;
		margin-top: 6px;
	}
	.hero-tag {
		margin-top: 6px;
		font-size: 13px;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: rgba(237, 226, 211, 0.75);
	}
	.hero-img {
		background: var(--espresso);
	}
	.hero-img img {
		width: 100%;
		height: 100%;
		min-height: 620px;
		object-fit: cover;
	}
	@media (max-width: 1000px) {
		.hero {
			grid-template-columns: 1fr;
			gap: 0;
		}
		.hero-copy {
			padding: 68px 24px;
		}
		.hero-img img {
			min-height: 400px;
		}
	}
	@media (max-width: 660px) {
		.hero-copy {
			padding: 56px 20px;
		}
		.hero-img img {
			min-height: 300px;
		}
	}

	/* Food */
	.food-section {
		padding: 96px 32px 40px;
	}
	.food-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 40px;
		flex-wrap: wrap;
	}
	.food-head-copy {
		display: flex;
		flex-direction: column;
		gap: 14px;
		max-width: 34em;
	}
	.preorder-link {
		font-size: 14px;
		font-weight: 600;
		color: var(--rust);
		border-bottom: 1px solid rgba(164, 83, 48, 0.4);
		white-space: nowrap;
	}
	.preorder-link:hover {
		color: var(--espresso);
	}
	.food-grid {
		margin-top: 44px;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 22px;
	}
	.dish-card {
		display: flex;
		flex-direction: column;
		background: var(--white);
		overflow: hidden;
	}
	.dish-img {
		width: 100%;
