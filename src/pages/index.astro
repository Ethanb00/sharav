</style>

<script>
	// --- Rotating place name in the hero ---
	const PLACES = ['Olney', 'Silver Spring', 'North Bethesda', 'Rockville', 'Takoma Park', 'Kensington', 'Bethesda', 'Wheaton'];
	const placeEl = document.getElementById('place-rotator');
	if (placeEl) {
		let i = 0;
		setInterval(() => {
			i = (i + 1) % PLACES.length;
			placeEl.textContent = PLACES[i];
			placeEl.style.animation = 'none';
			// restart the entrance animation each time
			void (placeEl as HTMLElement).offsetWidth;
			placeEl.style.animation = '';
		}, 2400);
	}

	// --- Cart (client-side only; product data sourced live from Wix Stores at render time) ---
	type CartLine = { sku: string; name: string; price: number; qty: number };
	const CART_KEY = 'sharav-cart';

	function loadCart(): CartLine[] {
		try {
			return JSON.parse(localStorage.getItem(CART_KEY) ?? '[]');
		} catch {
			return [];
		}
	}
	function saveCart(cart: CartLine[]) {
		localStorage.setItem(CART_KEY, JSON.stringify(cart));
	}
	function renderCart() {
		const cart = loadCart();
		const linesEl = document.getElementById('cart-lines');
		const emptyEl = document.getElementById('cart-empty');
		const totalEl = document.getElementById('cart-total');
		const countEl = document.getElementById('cart-count');
		if (!linesEl || !totalEl || !countEl) return;

		linesEl.querySelectorAll('[data-cart-line]').forEach((el) => el.remove());
		let total = 0;
		let count = 0;
		for (const line of cart) {
			total += line.price * line.qty;
			count += line.qty;
			const li = document.createElement('li');
			li.className = 'cart-line';
			li.setAttribute('data-cart-line', line.sku);
			const label = line.qty > 1 ? `${line.name} × ${line.qty}` : line.name;
			li.innerHTML = `<span class="cart-line-left"><button type="button" class="cart-line-remove" data-remove="${line.sku}">&times;</button><span class="cart-line-name">${label}</span></span><span class="cart-line-amount">$${(line.price * line.qty).toFixed(0)}</span>`;
			linesEl.appendChild(li);
		}
		if (emptyEl) emptyEl.style.display = cart.length ? 'none' : '';
		totalEl.textContent = `$${total.toFixed(0)}`;
		countEl.textContent = String(count);

		linesEl.querySelectorAll('[data-remove]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const sku = (btn as HTMLElement).getAttribute('data-remove');
				const cart2 = loadCart();
				const idx = cart2.findIndex((l) => l.sku === sku);
				if (idx !== -1) {
					cart2[idx].qty -= 1;
					if (cart2[idx].qty <= 0) cart2.splice(idx, 1);
				}
				saveCart(cart2);
				renderCart();
			});
		});
	}

	document.addEventListener('click', (e) => {
		const btn = (e.target as HTMLElement)?.closest('.add-to-order') as HTMLElement | null;
		if (!btn) return;
		const card = btn.closest('[data-sku]') as HTMLElement | null;
		if (!card) return;
		const sku = card.dataset.sku!;
		const name = card.dataset.name!;
		const price = Number(card.dataset.price ?? '0');
		const cart = loadCart();
		const existing = cart.find((l) => l.sku === sku);
		if (existing) existing.qty += 1;
		else cart.push({ sku, name, price, qty: 1 });
		saveCart(cart);
		renderCart();
	});

	renderCart();

	function normalizePhone(raw: string): string {
		return raw.replace(/[\s()\-.]/g, '');
	}

	function isValidEmail(value: string): boolean {
		return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
	}

	function isValidPhone(digits: string): boolean {
		return /^\+?\d{10,15}$/.test(digits);
	}

	function showFormError(statusEl: HTMLElement | null, form: HTMLFormElement, message: string, fieldName?: string) {
		if (statusEl) {
			statusEl.textContent = message;
			statusEl.className = 'form-status error';
		}
		if (fieldName) {
			(form.elements.namedItem(fieldName) as HTMLElement | null)?.focus();
		}
	}

	async function postJSON(url: string, body: unknown) {
		const res = await fetch(url, {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify(body),
		});
		let data: any = null;
		try {
			data = await res.json();
		} catch {
			data = null;
		}
		if (!res.ok) throw new Error(data?.error || 'Something went wrong - please try again.');
		return data;
	}

	// --- Pre-order form ---
	const preorderForm = document.getElementById('preorder-form') as HTMLFormElement | null;
	const preorderStatus = document.getElementById('preorder-status');

	// Returning from a completed Square checkout redirect (see checkout_options.redirect_url
	// in /api/preorder.ts) - the cart was already cleared before we left for Square.
	if (new URLSearchParams(window.location.search).get('order') === 'success') {
		if (preorderStatus) {
			preorderStatus.textContent = "Payment received - we'll see you at pickup!";
			preorderStatus.className = 'form-status';
		}
		history.replaceState(null, '', window.location.pathname + window.location.hash);
	}

	preorderForm?.addEventListener('submit', async (e) => {
		e.preventDefault();
		const cart = loadCart();
		if (!cart.length) {
			showFormError(preorderStatus, preorderForm, 'Add at least one dish to your order first.');
			return;
		}
		const fd = new FormData(preorderForm);
		const fullName = String(fd.get('full_name') ?? '').trim();
		const email = String(fd.get('email') ?? '').trim();
		const phone = normalizePhone(String(fd.get('phone') ?? ''));

		if (!fullName) {
			showFormError(preorderStatus, preorderForm, 'Please enter your name.', 'full_name');
			return;
		}
		if (!isValidPhone(phone)) {
			showFormError(preorderStatus, preorderForm, 'Please enter a valid phone number.', 'phone');
			return;
		}
		if (!isValidEmail(email)) {
			showFormError(preorderStatus, preorderForm, 'Please enter a valid email address.', 'email');
			return;
		}

		if (preorderStatus) {
			preorderStatus.textContent = 'Starting checkout…';
			preorderStatus.className = 'form-status';
		}
		try {
			const { url } = await postJSON('/api/preorder', {
				full_name: fullName,
				phone,
				email,
				notes: fd.get('notes'),
				cart,
			});
			saveCart([]);
			window.location.href = url;
		} catch (err) {
			showFormError(preorderStatus, preorderForm, err instanceof Error ? err.message : 'Something went wrong - please try again or call us.');
		}
	});

	// --- Catering form ---
	const cateringForm = document.getElementById('catering-form') as HTMLFormElement | null;
	const cateringStatus = document.getElementById('catering-status');
	cateringForm?.addEventListener('submit', async (e) => {
		e.preventDefault();
		const fd = new FormData(cateringForm);
		const fullName = String(fd.get('full_name') ?? '').trim();
		const email = String(fd.get('email') ?? '').trim();
		const eventDate = String(fd.get('event_date') ?? '').trim();
		const guestCount = Number(fd.get('guest_count'));
		const occasion = String(fd.get('occasion') ?? '').trim();

		if (!fullName) {
			showFormError(cateringStatus, cateringForm, 'Please enter your name.', 'full_name');
			return;
		}
		if (!isValidEmail(email)) {
			showFormError(cateringStatus, cateringForm, 'Please enter a valid email address.', 'email');
			return;
		}
		if (!eventDate) {
			showFormError(cateringStatus, cateringForm, 'Please choose an event date.', 'event_date');
			return;
		}
		if (!guestCount || guestCount < 1) {
			showFormError(cateringStatus, cateringForm, 'Please let us know how many guests.', 'guest_count');
			return;
		}
		if (!occasion) {
			showFormError(cateringStatus, cateringForm, 'Tell us a bit about the occasion.', 'occasion');
			return;
		}

		if (cateringStatus) {
			cateringStatus.textContent = 'Sending…';
			cateringStatus.className = 'form-status';
		}
		try {
			await postJSON('/api/catering', {
				full_name: fullName,
				email,
				event_date: eventDate,
				guest_count: guestCount,
				occasion,
			});
			cateringForm.reset();
			if (cateringStatus) {
				cateringStatus.textContent = "Thanks - we'll follow up with a quote soon.";
				cateringStatus.className = 'form-status';
			}
		} catch (err) {
			showFormError(cateringStatus, cateringForm, err instanceof Error ? err.message : 'Something went wrong - please try again or email us.');
		}
	});

	// --- Newsletter forms (mid-page + footer) ---
	function wireNewsletter(formId: string, statusId: string) {
		const form = document.getElementById(formId) as HTMLFormElement | null;
		const statusEl = document.getElementById(statusId);
		form?.addEventListener('submit', async (e) => {
			e.preventDefault();
			if (!form) return;
			const fd = new FormData(form);
			const email = String(fd.get('email') ?? '').trim();
			if (!isValidEmail(email)) {
				showFormError(statusEl, form, 'Please enter a valid email address.', 'email');
				return;
			}
			if (statusEl) {
				statusEl.textContent = 'Sending…';
				statusEl.className = 'form-status';
			}
			try {
				await postJSON('/api/newsletter', { email });
				form.reset();
				if (statusEl) {
					statusEl.textContent = "You're on the list - watch for the first one.";
					statusEl.className = 'form-status';
				}
			} catch (err) {
				showFormError(statusEl, form, err instanceof Error ? err.message : 'Something went wrong - please try again.');
			}
		});
	}
	wireNewsletter('newsletter-form', 'newsletter-status');
	wireNewsletter('footer-newsletter-form', 'footer-newsletter-status');
</script>
