<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <img src="/images/brand/icon-white.svg" alt="" class="footer-brand-icon">
      <div class="footer-brand-text">
        <img src="/images/brand/wordmark-white.svg" alt="{{ site.name }}" class="footer-brand-wordmark">
        <span class="footer-brand-subtitle">{{ site.tagline }}</span>
      </div>
    </div>
    <p>&copy; {{ currentYear }} {{ site.name }}. Photography coming soon.</p>
  </div>
</footer>
