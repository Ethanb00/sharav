---
export interface Props {
	title?: string;
	description?: string;
}
const {
	title = 'Sharav — Mizrahi Jewish Prepared Food',
	description = 'Sharav brings Mizrahi Jewish pita and mezze to farmers markets around Washington, DC and Maryland.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--rust: #a45330;
		--rust-dark: #8a4327;
		--espresso: #412e15;
		--cream: #ede2d3;
		--cream-dark: #e1d2b9;
		--gold: #d2963b;
		--gold-dark: #b37f2f;
		--olive: #5e5e30;
		--white: #ffffff;
		--font-body: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
		--max-width: 1120px;
	}

	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		font-family: var(--font-body);
		font-weight: 400;
		color: var(--espresso);
		background: var(--cream);
		line-height: 1.6;
	}

	img,
	svg {
		max-width: 100%;
		display: block;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	.wrap {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 0 24px;
	}

	h1,
	h2,
	h3 {
		font-family: var(--font-body);
		font-weight: 600;
		line-height: 1.2;
		margin: 0 0 16px;
		color: var(--espresso);
	}

	h1 {
		font-size: clamp(2.1rem, 4.6vw, 3.2rem);
	}
	h2 {
		font-size: clamp(1.6rem, 3.2vw, 2.2rem);
	}
	h3 {
		font-size: 1.15rem;
		margin-bottom: 8px;
	}

	p {
		margin: 0 0 16px;
	}

	.eyebrow {
		font-family: var(--font-body);
		text-transform: uppercase;
		letter-spacing: 0.14em;
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--rust);
		margin: 0 0 10px;
	}

	.section {
		padding: 80px 0;
	}
	.section-sub {
		max-width: 640px;
		color: #6b5738;
	}

	.btn {
		display: inline-block;
		padding: 13px 28px;
		border-radius: 999px;
		font-weight: 600;
		font-size: 0.95rem;
		border: 2px solid transparent;
		cursor: pointer;
		transition:
			transform 0.15s ease,
			background 0.15s ease,
			color 0.15s ease;
	}
	.btn:hover {
		transform: translateY(-1px);
	}
	.btn-primary {
		background: var(--gold);
		color: var(--espresso);
	}
	.btn-primary:hover {
		background: var(--gold-dark);
	}
	.btn-ghost {
		border-color: rgba(237, 226, 211, 0.55);
		color: var(--cream);
		background: transparent;
	}
	.btn-ghost:hover {
		border-color: var(--cream);
		background: rgba(237, 226, 211, 0.08);
	}
	.btn-dark {
		border-color: var(--espresso);
		color: var(--espresso);
		background: transparent;
	}
	.btn-dark:hover {
		background: var(--espresso);
		color: var(--cream);
	}

	.themed-block {
		background: linear-gradient(160deg, var(--cream-dark) 0%, var(--cream) 100%);
		border: 1.5px dashed #c9a97a;
		border-radius: 14px;
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 160px;
		position: relative;
		overflow: hidden;
	}
	.themed-block::after {
		content: attr(data-label);
		position: absolute;
		bottom: 12px;
		left: 50%;
		transform: translateX(-50%);
		padding: 6px 12px;
		background: rgba(237, 226, 211, 0.9);
		border-radius: 8px;
		color: #8a7048;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		white-space: nowrap;
	}

	/* Header */
	.site-header {
		width: 100%;
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(237, 226, 211, 0.92);
		backdrop-filter: blur(6px);
		border-bottom: 1px solid var(--cream-dark);
	}
	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-top: 14px;
		padding-bottom: 14px;
	}
	.wordmark-img {
		height: 28px;
		width: auto;
	}
	.site-nav {
		display: flex;
		align-items: center;
		gap: 28px;
		font-size: 0.92rem;
		font-weight: 500;
	}
	.site-nav a {
		transition: color 0.15s ease;
	}
	.site-nav a:hover {
		color: var(--rust);
	}
	.nav-cta {
		background: var(--rust);
		color: var(--white) !important;
		padding: 8px 18px;
		border-radius: 999px;
		font-weight: 600;
	}
	.nav-cta:hover {
		background: var(--rust-dark);
	}
	.nav-toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		width: 36px;
		height: 36px;
		background: none;
		border: none;
		cursor: pointer;
	}
	.nav-toggle span {
		display: block;
		height: 2px;
		background: var(--espresso);
		border-radius: 2px;
	}

	/* Footer */
	.site-footer {
		background: var(--espresso);
		color: #cbb187;
		padding: 56px 0 32px;
		position: relative;
		overflow: hidden;
	}
	.footer-illustration {
		position: absolute;
		right: -60px;
		bottom: -60px;
		width: 320px;
		opacity: 0.12;
		pointer-events: none;
	}
	.footer-top {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 32px;
		margin-bottom: 32px;
		position: relative;
	}
	.footer-brand-wordmark {
		height: 22px;
		width: auto;
		margin-bottom: 12px;
	}
	.footer-nav {
		display: flex;
		gap: 24px;
		flex-wrap: wrap;
		font-size: 0.92rem;
	}
	.footer-nav a:hover {
		color: var(--cream);
	}
	.footer-bottom {
		border-top: 1px solid rgba(203, 177, 135, 0.25);
		padding-top: 20px;
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		justify-content: space-between;
		font-size: 0.82rem;
		position: relative;
	}

	/* Responsive */
	@media (max-width: 640px) {
		.nav-toggle {
			display: flex;
		}
		.site-nav {
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			background: var(--cream);
			border-bottom: 1px solid var(--cream-dark);
			flex-direction: column;
			align-items: flex-start;
			gap: 0;
			padding: 8px 24px 20px;
			display: none;
		}
		.site-nav.open {
			display: flex;
		}
		.site-nav a {
			width: 100%;
			padding: 12px 0;
			border-bottom: 1px solid var(--cream-dark);
		}
		.nav-cta {
			margin-top: 12px;
			text-align: center;
		}
	}
</style>
