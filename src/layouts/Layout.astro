---
export interface Props {
	title?: string;
	description?: string;
}
const {
	title = "Sharav · Mizrahi Cuisine · Greater Washington, DC",
	description = "Small-batch Mizrahi-Jewish mezze and fresh-baked pita — hummus, zhug, muhammara and roasted za'atar carrot, made by hand each week in Maryland. Preorder for market pickup.",
} = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content="Sharav · Mizrahi Cuisine" />
		<meta property="og:description" content="Small-batch Mizrahi-Jewish mezze and fresh-baked pita, made by hand each week in Maryland. Preorder for market pickup." />
		<meta property="og:type" content="website" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600&display=block" rel="stylesheet" />
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--rust: #a45330;
		--espresso: #412e15;
		--cream: #ede2d3;
		--gold: #d2963b;
		--olive: #5e5e30;
		--mauve: #5f3048;
		--white: #ffffff;
		--font-body: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
		--max-width: 1200px;
	}

	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		font-family: var(--font-body);
		font-weight: 400;
		font-synthesis: none;
		color: var(--espresso);
		background: var(--cream);
		line-height: 1.6;
		overflow-x: hidden;
	}

	img,
	svg {
		max-width: 100%;
		display: block;
	}

	a {
		color: var(--rust);
		text-decoration: none;
	}
	a:hover {
		color: var(--espresso);
	}

	input,
	textarea,
	button,
	select {
		box-sizing: border-box;
		width: 100%;
		min-width: 0;
		max-width: 100%;
		font-family: inherit;
	}

	.wrap {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 0 32px;
	}

	h1,
	h2,
	h3 {
		font-family: var(--font-body);
		font-weight: 600;
		line-height: 1.1;
		letter-spacing: -0.02em;
		margin: 0;
		color: var(--espresso);
	}

	p {
		margin: 0;
	}

	.eyebrow {
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--rust);
	}

	@keyframes sharavPlaceIn {
		from {
			opacity: 0;
			transform: translateY(0.3em);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		#place-rotator {
			animation: none !important;
		}
	}

	/* Header */
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(237, 226, 211, 0.96);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid rgba(65, 46, 21, 0.14);
	}
	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 32px;
		padding: 14px 0;
	}
	.wordmark-img {
		width: 172px;
		height: auto;
	}
	.site-nav {
		display: flex;
		align-items: center;
		gap: 28px;
	}
	.site-nav a {
		font-size: 14px;
		font-weight: 500;
		color: var(--espresso);
	}
	.site-nav a:hover {
		color: var(--rust);
	}
	.nav-cta {
		padding: 11px 22px;
		background: var(--rust);
		color: var(--cream) !important;
		font-size: 14px;
		font-weight: 600;
		letter-spacing: 0.02em;
	}
	.nav-cta:hover {
		background: var(--espresso) !important;
	}

	@media (max-width: 1000px) {
		.site-nav a:not(.nav-cta) {
			display: none;
		}
	}
</style>
