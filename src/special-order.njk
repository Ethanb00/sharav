<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Special Order — Sharav</title>
<meta name="description" content="Pre-order dips, spreads, and pita from Sharav for market pickup or local delivery.">
<link rel="icon" href="/images/brand/icon-color.svg" type="image/svg+xml" media="(prefers-color-scheme: light)">
<link rel="icon" href="/images/brand/icon-white.svg" type="image/svg+xml" media="(prefers-color-scheme: dark)">
<link rel="icon" href="/images/brand/icon-color.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/special-order.css">
</head>
<body>

<script type="application/json" id="special-order-data">{{ specialOrder | json | safe }}</script>

<div class="so-page">

  <header class="so-header">
    <div class="so-header-inner">
      <a href="/" aria-label="Back to eatsharav.com">
        <img src="/images/brand/logo-cream.svg" alt="Sharav" class="so-header-logo">
      </a>
      <div class="so-header-title">
        <div class="so-header-h1">Special Order</div>
        <div class="so-header-sub">Market pickup &amp; local delivery</div>
      </div>
    </div>
  </header>
  <div class="so-accent-bar"></div>

  <main class="so-main">

    <section id="so-confirmation" class="so-confirm" hidden>
      <img src="/images/brand/icon-color.svg" alt="" class="so-confirm-icon">
      <div class="so-confirm-title">Order request received</div>
      <p class="so-confirm-body">Thanks — we'll confirm your total and pickup details by email within one business day. Nothing is charged until you approve it.</p>
      <p class="so-confirm-summary" id="so-confirm-summary"></p>
      <button type="button" id="so-reset" class="so-btn-outline">Start another order</button>
    </section>

    <form id="so-form" class="so-form">

      <div class="so-badges">
        <div class="so-badge">
          <div class="so-badge-label">Minimum</div>
          <div class="so-badge-value" id="so-badge-minimum"></div>
        </div>
        <div class="so-badge">
          <div class="so-badge-label">Lead time</div>
          <div class="so-badge-value" id="so-badge-leadtime"></div>
        </div>
        <div class="so-badge">
          <div class="so-badge-label">Deposit</div>
          <div class="so-badge-value" id="so-badge-deposit"></div>
        </div>
      </div>

      <div class="so-section">
        <div class="so-section-head">
          <div class="so-section-title">Dips &amp; spreads</div>
          <div class="so-section-hint">Pick a size, then a quantity</div>
        </div>
        <div id="so-dips" class="so-dip-list"></div>
      </div>

      <div class="so-section">
        <div class="so-section-head">
          <div class="so-section-title">Pita</div>
          <div class="so-section-hint">By the dozen</div>
        </div>
        <div id="so-pitas" class="so-pita-list"></div>
      </div>

      <div class="so-section">
        <div class="so-section-head">
          <div class="so-section-title">Special requests</div>
          <div class="so-section-hint">Optional</div>
        </div>
        <p class="so-section-note">Something not on the list? Ask — we'll see what we can do.</p>
        <textarea id="so-requests" class="so-textarea" placeholder="e.g. can you also make labneh?" rows="3"></textarea>
      </div>

      <div class="so-section">
        <div class="so-section-head">
          <div class="so-section-title">Your details</div>
          <div class="so-section-hint">All fields required</div>
        </div>
        <div class="so-field-grid">
          <label class="so-field">
            <span class="so-field-label">Name</span>
            <input type="text" id="so-name" class="so-input" autocomplete="name">
          </label>
          <label class="so-field">
            <span class="so-field-label">Phone</span>
            <input type="tel" id="so-phone" class="so-input" autocomplete="tel">
          </label>
          <label class="so-field">
            <span class="so-field-label">Email</span>
            <input type="email" id="so-email" class="so-input" autocomplete="email">
          </label>
          <label class="so-field">
            <span class="so-field-label">Needed by</span>
            <input type="date" id="so-date" class="so-input">
          </label>
        </div>
        <div class="so-fulfil-toggle">
          <button type="button" id="so-pick-market" class="so-toggle-btn is-active">Pick up at market</button>
          <button type="button" id="so-pick-delivery" class="so-toggle-btn">Delivery</button>
        </div>
        <label class="so-field">
          <span class="so-field-label" id="so-where-label">Which market</span>
          <input type="text" id="so-where" class="so-input">
        </label>
        <label class="so-field">
          <span class="so-field-label">Allergies &amp; dietary restrictions</span>
          <textarea id="so-notes" class="so-textarea" rows="2"></textarea>
        </label>
      </div>

      <div class="so-total-panel">
        <div class="so-total-row">
          <div class="so-total-label">Estimated total</div>
          <div class="so-total-value" id="so-total-value">$0</div>
        </div>
        <p class="so-status" id="so-status"></p>
        <button type="submit" id="so-submit" class="so-submit-btn" disabled>Request this order</button>
        <p class="so-error" id="so-error" hidden></p>
      </div>

      <div class="so-info-grid">
        {% for card in specialOrder.infoCards %}
        <div class="so-info-card">
          <div class="so-info-label">{{ card.label }}</div>
          <div class="so-info-body">{{ card.body }}</div>
        </div>
        {% endfor %}
      </div>

    </form>

  </main>

  <footer class="so-footer">
    <div class="so-footer-inner">{{ specialOrder.phone }} &middot; {{ specialOrder.email }} &middot; {{ specialOrder.instagram }}</div>
  </footer>

</div>

<script src="/js/special-order.js"></script>
</body>
</html>
